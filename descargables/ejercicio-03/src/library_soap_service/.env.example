# Copia este archivo a .env y coloca los valores reales.
# Misma base de datos que el monolito — solo lectura de su catálogo,
# escritura únicamente en las tablas propias (sql/soap_module.sql).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=soap_module_user
DB_PASS=CAMBIA_ESTA_CONTRASENA_ROL_SOAP

# Puerto distinto al del microservicio REST del Ejercicio03 (5000)
# para poder correr ambos servicios al mismo tiempo si hace falta.
PORT=5050
FLASK_DEBUG=0

# WS-Security (Tarea 1) -- protege ObtenerEstadisticasPorModelo.
# La contraseña NUNCA se guarda en texto plano, solo su hash. Generarlo con:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('tu-contrasena'))"
WS_SECURITY_USERNAME=admin-estadisticas
WS_SECURITY_PASSWORD_HASH=CAMBIA_ESTE_HASH_GENERADO_CON_WERKZEUG
